---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
---

<BaseLayout
  title={`Privacy Policy | ${site.siteName}`}
  description={`Privacy policy for ${site.siteName} — how we handle enquiry and consultation information.`}
>
  <section class="section-pad bg-surface">
    <div class="container-rc max-w-3xl prose-rc">
      <h1 class="text-3xl font-bold sm:text-4xl">Privacy Policy</h1>
      <p class="mt-6 text-muted">
        Last updated: August 2026
      </p>
      <div class="mt-8 space-y-5 text-sm leading-relaxed text-text sm:text-base">
        <p>
          {site.siteName} (“we”, “us”) respects your privacy. This page explains how we handle
          information you share when you contact us or request a consultation through our website.
        </p>
        <h2 class="pt-2 text-xl font-bold">Information we collect</h2>
        <p>
          When you submit our contact form, we collect your name, email address, phone number,
          business type, and message. We use this only to respond to your enquiry and provide
          relevant compliance guidance.
        </p>
        <h2 class="pt-2 text-xl font-bold">How we use information</h2>
        <p>
          We do not sell your personal information. Enquiry details may be stored securely to follow
          up on your request and improve our services.
        </p>
        <h2 class="pt-2 text-xl font-bold">Contact</h2>
        <p>
          For privacy-related questions, email us at
          <a class="font-medium text-emerald hover:text-emerald-dark" href={`mailto:${site.email}`}>
            {site.email}
          </a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
