---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import contact from '../../public/data/contact.json';
import site from '../../public/data/site.json';
---

<BaseLayout title={contact.seoTitle} description={contact.seoDescription}>
  <section class="bg-navy text-white">
    <div class="container-rc py-16 sm:py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-emerald">Contact</p>
      <h1 class="mt-3 max-w-3xl font-display text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
        {contact.headline}
      </h1>
      <p class="mt-4 max-w-2xl text-white/70">{contact.supportingText}</p>
    </div>
  </section>

  <section class="section-pad bg-surface">
    <div class="container-rc grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl font-bold">Book your consultation</h2>
        <p class="mt-3 text-muted">
          Share a few details and we’ll follow up with practical next steps for your compliance needs.
        </p>
        <div class="mt-8 space-y-4 text-sm sm:text-base">
          <p>
            <span class="font-semibold text-navy">Email:</span>
            <a class="ml-2 text-emerald hover:text-emerald-dark" href={`mailto:${site.email}`}>
              {site.email}
            </a>
          </p>
          {
            !site.phone.includes('X') && (
              <p>
                <span class="font-semibold text-navy">Phone:</span>
                <a class="ml-2 text-emerald hover:text-emerald-dark" href={`tel:${site.phone.replace(/\s/g, '')}`}>
                  {site.phone}
                </a>
              </p>
            )
          }
        </div>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
