---
import BaseLayout from '../../layouts/BaseLayout.astro';
import servicesData from '../../../public/data/services.json';
import site from '../../../public/data/site.json';
import Icon from '../../components/Icon.astro';

export function getStaticPaths() {
  return servicesData.items.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<BaseLayout title={service.seoTitle} description={service.seoDescription}>
  <section class="hero-atmosphere relative overflow-hidden text-white">
    <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-rc relative py-16 sm:py-20">
      <p class="fade-up text-sm font-semibold uppercase tracking-wider text-emerald">
        <a class="hover:text-white" href="/services">Services</a>
      </p>
      <div class="fade-up-delay-1 mt-5 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald/20 text-emerald">
        <Icon name={service.icon || 'spark'} class="h-7 w-7" />
      </div>
      <h1 class="fade-up-delay-1 mt-4 max-w-3xl font-display text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
        {service.title}
      </h1>
      <p class="fade-up-delay-2 mt-4 max-w-2xl text-white/70">{service.summary}</p>
    </div>
  </section>

  <section class="section-pad bg-surface">
    <div class="container-rc grid gap-12 lg:grid-cols-[1.4fr_1fr]">
      <div class="reveal">
        <h2 class="text-2xl font-bold">What’s included</h2>
        <ul class="mt-6 space-y-3">
          {
            service.bullets.map((bullet) => (
              <li class="flex gap-3 rounded-xl border border-transparent px-2 py-3 text-sm transition hover:border-emerald/20 hover:bg-white sm:text-base">
                <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-emerald/10 text-emerald">
                  <Icon name="check" class="h-3.5 w-3.5" />
                </span>
                <span>{bullet}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <aside class="reveal rounded-2xl border border-navy/10 bg-white p-6 shadow-[0_12px_32px_rgba(10,37,64,0.06)] sm:p-8">
        <div class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-emerald/10 text-emerald">
          <Icon name="support" class="h-5 w-5" />
        </div>
        <h2 class="text-xl font-bold">Talk to an expert</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Get clear advice on {service.title.toLowerCase()} for your business. Book a free consultation
          with {site.siteName}.
        </p>
        <a href="/contact" class="btn-primary mt-6 w-full">{site.ctaPrimary}</a>
        <a
          href={`mailto:${site.email}`}
          class="mt-4 block text-center text-sm font-medium text-emerald hover:text-emerald-dark"
        >
          {site.email}
        </a>
      </aside>
    </div>
  </section>
</BaseLayout>
