---
import BaseLayout from '../../layouts/BaseLayout.astro';
import servicesData from '../../data/services.json';
import site from '../../data/site.json';

export function getStaticPaths() {
  return servicesData.items.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<BaseLayout title={service.seoTitle} description={service.seoDescription}>
  <section class="bg-navy text-white">
    <div class="container-rc py-16 sm:py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-emerald">
        <a class="hover:text-white" href="/services">Services</a>
      </p>
      <h1 class="mt-3 max-w-3xl font-display text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
        {service.title}
      </h1>
      <p class="mt-4 max-w-2xl text-white/70">{service.summary}</p>
    </div>
  </section>

  <section class="section-pad bg-surface">
    <div class="container-rc grid gap-12 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <h2 class="text-2xl font-bold">What’s included</h2>
        <ul class="mt-6 space-y-3">
          {
            service.bullets.map((bullet) => (
              <li class="flex gap-3 border-b border-navy/10 pb-3 text-sm sm:text-base">
                <span class="mt-1.5 inline-block h-2 w-2 shrink-0 rounded-full bg-emerald" aria-hidden="true" />
                <span>{bullet}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <aside class="rounded-xl border border-navy/10 bg-white p-6 sm:p-8">
        <h2 class="text-xl font-bold">Talk to an expert</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Get clear advice on {service.title.toLowerCase()} for your business. Book a free consultation
          with {site.siteName}.
        </p>
        <a href="/contact" class="btn-primary mt-6 w-full">{site.ctaPrimary}</a>
        <a
          href={`mailto:${site.email}`}
          class="mt-4 block text-center text-sm font-medium text-emerald hover:text-emerald-dark"
        >
          {site.email}
        </a>
      </aside>
    </div>
  </section>
</BaseLayout>
