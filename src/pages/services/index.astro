---
import BaseLayout from '../../layouts/BaseLayout.astro';
import servicesData from '../../../public/data/services.json';
import site from '../../../public/data/site.json';

const sorted = [...servicesData.items].sort((a, b) => a.order - b.order);
---

<BaseLayout
  title={`Our Services | ${site.siteName} — Corporate Compliance India`}
  description="Company incorporation, ROC & secretarial compliance, GST registration, legal advisory, FEMA compliance and trademark services for businesses across India."
>
  <section class="bg-navy text-white">
    <div class="container-rc py-16 sm:py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-emerald">Services</p>
      <h1 class="mt-3 max-w-3xl font-display text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
        End-to-end corporate compliance services
      </h1>
      <p class="mt-4 max-w-2xl text-white/70">
        Startup legal services, secretarial services, business registration India, and ongoing
        regulatory support — practical and transparent.
      </p>
    </div>
  </section>

  <section class="section-pad bg-surface">
    <div class="container-rc space-y-12">
      {
        sorted.map((service) => (
          <article class="reveal border-t border-navy/10 pt-10 first:border-t-0 first:pt-0">
            <h2 class="text-2xl font-bold sm:text-3xl">
              <a class="hover:text-emerald" href={`/services/${service.slug}`}>
                {service.title}
              </a>
            </h2>
            <p class="mt-3 max-w-2xl text-muted">{service.summary}</p>
            <ul class="mt-6 grid gap-2 sm:grid-cols-2">
              {service.bullets.map((bullet) => (
                <li class="flex gap-3 text-sm sm:text-base">
                  <span class="mt-1.5 inline-block h-2 w-2 shrink-0 rounded-full bg-emerald" aria-hidden="true" />
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
            <a
              href={`/services/${service.slug}`}
              class="mt-6 inline-flex text-sm font-semibold text-emerald hover:text-emerald-dark"
            >
              Learn more →
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section-pad bg-surface-alt">
    <div class="container-rc text-center">
      <h2 class="text-2xl font-bold sm:text-3xl">Need help choosing a service?</h2>
      <p class="mx-auto mt-3 max-w-xl text-muted">
        Tell us about your business — we’ll recommend the right compliance path.
      </p>
      <a href="/contact" class="btn-primary mt-8 inline-flex">{site.ctaPrimary}</a>
    </div>
  </section>
</BaseLayout>
