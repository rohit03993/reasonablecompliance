---
import BaseLayout from '../../layouts/BaseLayout.astro';
import servicesData from '../../../public/data/services.json';
import site from '../../../public/data/site.json';
import Icon from '../../components/Icon.astro';

const sorted = [...servicesData.items].sort((a, b) => a.order - b.order);
---

<BaseLayout
  title={`Our Services | ${site.siteName} — Corporate Compliance India`}
  description="Company incorporation, ROC & secretarial compliance, GST registration, legal advisory, FEMA compliance and trademark services for businesses across India."
>
  <section class="hero-atmosphere relative overflow-hidden text-white">
    <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-rc relative py-16 sm:py-20">
      <p class="fade-up text-sm font-semibold uppercase tracking-wider text-emerald">Services</p>
      <h1 class="fade-up-delay-1 mt-3 max-w-3xl font-display text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
        End-to-end corporate compliance services
      </h1>
      <p class="fade-up-delay-2 mt-4 max-w-2xl text-white/70">
        From company registration and ROC filings to GST, FEMA, trademarks and legal advisory —
        practical, transparent support for startups and growing businesses across India.
      </p>
    </div>
  </section>

  <section class="section-pad bg-surface">
    <div class="container-rc space-y-10">
      {
        sorted.map((service, index) => (
          <article
            class="reveal group grid gap-6 rounded-2xl border border-navy/10 bg-white p-6 transition duration-300 hover:border-emerald/30 hover:shadow-[0_16px_40px_rgba(10,37,64,0.08)] sm:grid-cols-[auto_1fr] sm:p-8"
            style={`transition-delay: ${index * 50}ms`}
          >
            <div class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-emerald/10 text-emerald transition duration-300 group-hover:scale-110 group-hover:bg-emerald group-hover:text-white">
              <Icon name={service.icon || 'spark'} class="h-7 w-7" />
            </div>
            <div>
              <h2 class="text-2xl font-bold sm:text-3xl">
                <a class="transition hover:text-emerald" href={`/services/${service.slug}`}>
                  {service.title}
                </a>
              </h2>
              <p class="mt-3 max-w-2xl text-muted">{service.summary}</p>
              <ul class="mt-6 grid gap-2 sm:grid-cols-2">
                {service.bullets.map((bullet) => (
                  <li class="flex gap-3 text-sm sm:text-base">
                    <span class="mt-1.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald/10 text-emerald">
                      <Icon name="check" class="h-3 w-3" />
                    </span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
              <a
                href={`/services/${service.slug}`}
                class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-emerald transition group-hover:gap-2 hover:text-emerald-dark"
              >
                Learn more <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="relative overflow-hidden bg-navy text-white">
    <div class="pointer-events-none absolute inset-0 opacity-40" aria-hidden="true">
      <div class="absolute right-10 top-8 h-32 w-32 rounded-full bg-emerald/30 blur-3xl animate-float"></div>
    </div>
    <div class="container-rc relative section-pad text-center">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">Need help choosing a service?</h2>
      <p class="mx-auto mt-3 max-w-xl text-white/70">
        Tell us about your business — we’ll recommend the right compliance path.
      </p>
      <a href="/contact" class="btn-primary mt-8 inline-flex shadow-lg shadow-emerald/25">{site.ctaPrimary}</a>
    </div>
  </section>
</BaseLayout>
