---
import BaseLayout from '../layouts/BaseLayout.astro';
import about from '../../public/data/about.json';
import site from '../../public/data/site.json';
import Icon from '../components/Icon.astro';

const whyIcons = ['scale', 'clock', 'building', 'check', 'rocket', 'support'];
---

<BaseLayout title={about.seoTitle} description={about.seoDescription}>
  <section class="hero-atmosphere relative overflow-hidden text-white">
    <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-rc relative py-16 sm:py-20">
      <p class="fade-up text-sm font-semibold uppercase tracking-wider text-emerald">About</p>
      <h1 class="fade-up-delay-1 mt-3 max-w-3xl font-display text-3xl font-bold text-white sm:text-4xl lg:text-5xl" data-cms="about.title">
        {about.title}
      </h1>
      <p class="fade-up-delay-2 mt-4 text-white/70" data-cms="site.tagline">{site.tagline}</p>
    </div>
  </section>

  <section class="section-pad bg-surface">
    <div class="container-rc max-w-3xl space-y-5 text-base leading-relaxed text-text sm:text-lg" data-cms-about-paragraphs>
      {about.paragraphs.map((p) => <p class="reveal">{p}</p>)}
    </div>
  </section>

  <section class="section-pad bg-surface-alt">
    <div class="container-rc max-w-3xl">
      <h2 class="reveal text-3xl font-bold" data-cms="about.whyChooseTitle">{about.whyChooseTitle}</h2>
      <ul class="mt-8 space-y-3" data-cms-list="about.whyChooseBullets">
        {
          about.whyChooseBullets.map((item, index) => (
            <li class="reveal flex items-start gap-3 rounded-xl border border-transparent bg-white/80 px-3 py-3 text-sm leading-relaxed transition hover:border-emerald/30 hover:shadow-sm sm:text-base">
              <span class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-emerald/10 text-emerald">
                <Icon name={whyIcons[index % whyIcons.length]} class="h-4 w-4" />
              </span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
      <div class="reveal mt-10">
        <a href="/contact" class="btn-primary" data-cms="site.ctaPrimary">{site.ctaPrimary}</a>
      </div>
    </div>
  </section>
</BaseLayout>
