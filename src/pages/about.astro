---
import BaseLayout from '../layouts/BaseLayout.astro';
import about from '../data/about.json';
import site from '../data/site.json';
---

<BaseLayout title={about.seoTitle} description={about.seoDescription}>
  <section class="bg-navy text-white">
    <div class="container-rc py-16 sm:py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-emerald">About</p>
      <h1 class="mt-3 max-w-3xl font-display text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
        {about.title}
      </h1>
      <p class="mt-4 text-white/70">{site.tagline}</p>
    </div>
  </section>

  <section class="section-pad bg-surface">
    <div class="container-rc max-w-3xl space-y-5 text-base leading-relaxed text-text sm:text-lg">
      {about.paragraphs.map((p) => <p class="reveal">{p}</p>)}
    </div>
  </section>

  <section class="section-pad bg-surface-alt">
    <div class="container-rc max-w-3xl">
      <h2 class="reveal text-3xl font-bold">{about.whyChooseTitle}</h2>
      <ul class="reveal mt-8 space-y-3">
        {
          about.whyChooseBullets.map((item) => (
            <li class="flex gap-3 text-sm leading-relaxed sm:text-base">
              <span class="mt-1.5 inline-block h-2 w-2 shrink-0 rounded-full bg-emerald" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
      <div class="reveal mt-10">
        <a href="/contact" class="btn-primary">{site.ctaPrimary}</a>
      </div>
    </div>
  </section>
</BaseLayout>
