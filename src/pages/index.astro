---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServicesOverview from '../components/ServicesOverview.astro';
import TrustSection from '../components/TrustSection.astro';
import Industries from '../components/Industries.astro';
import Process from '../components/Process.astro';
import StatsStrip from '../components/StatsStrip.astro';
import Testimonials from '../components/Testimonials.astro';
import BlogTeasers from '../components/BlogTeasers.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import site from '../../public/data/site.json';
---

<BaseLayout
  title={site.seoDefaultTitle}
  description={site.seoDefaultDescription}
>
  <Hero />
  <StatsStrip />
  <ServicesOverview />
  <TrustSection />
  <Industries />
  <Process />
  <Testimonials />
  <BlogTeasers />
  <FAQ />
  <FinalCTA />
</BaseLayout>
