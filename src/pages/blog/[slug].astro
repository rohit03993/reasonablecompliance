---
import BaseLayout from '../../layouts/BaseLayout.astro';
import blog from '../../../public/data/blog.json';

export function getStaticPaths() {
  return blog.items
    .filter((post) => (post.status || 'published') !== 'draft')
    .map((post) => ({
      params: { slug: post.slug },
      props: { post },
    }));
}

const { post } = Astro.props;

function formatDate(dateStr: string) {
  try {
    return new Date(dateStr + 'T00:00:00').toLocaleDateString('en-IN', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
  } catch {
    return dateStr;
  }
}

function bodyToHtml(body: string) {
  const raw = String(body || '').trim();
  if (!raw) return '';
  if (/<[a-z][\s\S]*>/i.test(raw)) return raw;
  return raw
    .split(/\n\s*\n/)
    .map((block) => block.trim())
    .filter(Boolean)
    .map((block) => {
      const lines = block.split('\n');
      const isList = lines.every((line) => !line.trim() || line.trim().startsWith('- '));
      if (isList) {
        return (
          '<ul>' +
          lines
            .filter((line) => line.trim().startsWith('- '))
            .map((line) => '<li>' + line.replace(/^\s*-\s*/, '') + '</li>')
            .join('') +
          '</ul>'
        );
      }
      if (lines.length === 1 && lines[0].length < 80 && !lines[0].endsWith('.')) {
        return '<h2>' + lines[0] + '</h2>';
      }
      return '<p>' + lines.join('<br>') + '</p>';
    })
    .join('');
}

const bodyHtml = bodyToHtml(post.body || '');
---

<BaseLayout title={post.seoTitle || `${post.title} | Reasonable Compliance`} description={post.seoDescription || post.excerpt}>
  <article>
    <section class="hero-atmosphere relative overflow-hidden text-white">
      <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="container-rc relative py-16 sm:py-20">
        <p class="fade-up text-sm font-semibold uppercase tracking-wider text-emerald">
          <a class="hover:text-white" href="/blog">Blog</a>
        </p>
        <h1 class="fade-up-delay-1 mt-3 max-w-3xl font-display text-3xl font-bold text-white sm:text-4xl lg:text-5xl" data-blog-title>
          {post.title}
        </h1>
        <p class="fade-up-delay-2 mt-4 text-sm text-white/70" data-blog-meta>
          {formatDate(post.date)}
          {post.author ? ` · ${post.author}` : ''}
        </p>
      </div>
    </section>

    <section class="section-pad bg-surface">
      <div class="container-rc max-w-3xl">
        {
          post.image && (
            <div class="reveal overflow-hidden rounded-2xl border border-navy/10 bg-white">
              <img
                src={post.image}
                alt={post.title}
                class="aspect-[16/9] w-full object-cover"
                data-blog-image
                loading="eager"
              />
            </div>
          )
        }
        <p class:list={['text-lg leading-relaxed text-muted', post.image ? 'mt-8' : '']} data-blog-excerpt>
          {post.excerpt}
        </p>
        <div class="blog-prose reveal mt-8" data-blog-body set:html={bodyHtml} />

        <div class="reveal mt-12 flex flex-wrap gap-3 border-t border-navy/10 pt-8">
          <a href="/blog" class="btn-outline">← Back to blog</a>
          <a href="/contact" class="btn-primary">Book a consultation</a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<script define:vars={{ slug: post.slug }}>
  function formatDate(dateStr) {
    try {
      return new Date(dateStr + 'T00:00:00').toLocaleDateString('en-IN', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
      });
    } catch {
      return dateStr;
    }
  }

  function bodyToHtml(body) {
    var raw = String(body || '').trim();
    if (!raw) return '';
    if (/<[a-z][\s\S]*>/i.test(raw)) return raw;
    return raw
      .split(/\n\s*\n/)
      .map(function (block) {
        return block.trim();
      })
      .filter(Boolean)
      .map(function (block) {
        var lines = block.split('\n');
        var isList = lines.every(function (line) {
          return !line.trim() || line.trim().startsWith('- ');
        });
        if (isList) {
          return (
            '<ul>' +
            lines
              .filter(function (line) {
                return line.trim().startsWith('- ');
              })
              .map(function (line) {
                return '<li>' + line.replace(/^\s*-\s*/, '') + '</li>';
              })
              .join('') +
            '</ul>'
          );
        }
        if (lines.length === 1 && lines[0].length < 80 && !lines[0].endsWith('.')) {
          return '<h2>' + lines[0] + '</h2>';
        }
        return '<p>' + lines.join('<br>') + '</p>';
      })
      .join('');
  }

  async function refreshPost() {
    try {
      const blog = await fetch('/data/blog.json', { cache: 'no-store' }).then((r) => r.json());
      const post = (blog.items || []).find((item) => item.slug === slug);
      if (!post) return;
      const titleEl = document.querySelector('[data-blog-title]');
      const metaEl = document.querySelector('[data-blog-meta]');
      const excerptEl = document.querySelector('[data-blog-excerpt]');
      const bodyEl = document.querySelector('[data-blog-body]');
      const imageEl = document.querySelector('[data-blog-image]');
      if (titleEl) titleEl.textContent = post.title || '';
      if (metaEl) metaEl.textContent = formatDate(post.date) + (post.author ? ' · ' + post.author : '');
      if (excerptEl) excerptEl.textContent = post.excerpt || '';
      if (bodyEl) bodyEl.innerHTML = bodyToHtml(post.body);
      if (imageEl && post.image) imageEl.setAttribute('src', post.image);
      if (post.seoTitle) document.title = post.seoTitle;
    } catch (e) {
      console.warn('Blog post live refresh skipped', e);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', refreshPost);
  } else {
    refreshPost();
  }
</script>
