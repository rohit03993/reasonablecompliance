---
import BaseLayout from '../../layouts/BaseLayout.astro';
import blog from '../../../public/data/blog.json';

const posts = [...blog.items].sort((a, b) => String(b.date).localeCompare(String(a.date)));

function formatDate(dateStr: string) {
  try {
    return new Date(dateStr + 'T00:00:00').toLocaleDateString('en-IN', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    });
  } catch {
    return dateStr;
  }
}
---

<BaseLayout
  title={`${blog.title} | Reasonable Compliance`}
  description={blog.intro}
>
  <section class="hero-atmosphere relative overflow-hidden text-white">
    <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-rc relative py-16 sm:py-20">
      <p class="fade-up text-sm font-semibold uppercase tracking-wider text-emerald">Insights</p>
      <h1 class="fade-up-delay-1 mt-3 max-w-3xl font-display text-3xl font-bold text-white sm:text-4xl lg:text-5xl" data-cms="blog.title">
        {blog.title}
      </h1>
      <p class="fade-up-delay-2 mt-4 max-w-2xl text-white/70" data-cms="blog.intro">{blog.intro}</p>
    </div>
  </section>

  <section class="section-pad bg-surface">
    <div class="container-rc">
      <ul class="grid gap-6 md:grid-cols-2" data-cms-blog-list>
        {
          posts.map((post, index) => (
            <li
              class="reveal group overflow-hidden rounded-2xl border border-navy/10 bg-white transition duration-300 hover:-translate-y-1 hover:border-emerald/30 hover:shadow-[0_16px_40px_rgba(10,37,64,0.08)]"
              style={`transition-delay: ${index * 50}ms`}
            >
              {post.image && (
                <a href={`/blog/${post.slug}`} class="block aspect-[16/9] overflow-hidden bg-surface-alt">
                  <img
                    src={post.image}
                    alt={post.title}
                    class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                </a>
              )}
              <div class="p-6 sm:p-8">
                <p class="text-xs font-semibold uppercase tracking-wider text-emerald">
                  {formatDate(post.date)}
                  {post.author ? ` · ${post.author}` : ''}
                </p>
                <h2 class="mt-3 text-xl font-bold text-navy transition group-hover:text-emerald sm:text-2xl">
                  <a href={`/blog/${post.slug}`}>{post.title}</a>
                </h2>
                <p class="mt-3 text-sm leading-relaxed text-muted sm:text-base">{post.excerpt}</p>
                <a
                  href={`/blog/${post.slug}`}
                  class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-emerald transition group-hover:gap-2"
                >
                  Read article <span aria-hidden="true">→</span>
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  function formatDate(dateStr) {
    try {
      return new Date(dateStr + 'T00:00:00').toLocaleDateString('en-IN', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      });
    } catch {
      return dateStr;
    }
  }

  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  async function refreshBlogList() {
    try {
      const blog = await fetch('/data/blog.json', { cache: 'no-store' }).then((r) => r.json());
      const posts = (blog.items || []).slice().sort((a, b) => String(b.date).localeCompare(String(a.date)));
      document.querySelectorAll('[data-cms="blog.title"]').forEach((el) => {
        el.textContent = blog.title || 'Our Blog';
      });
      document.querySelectorAll('[data-cms="blog.intro"]').forEach((el) => {
        el.textContent = blog.intro || '';
      });
      document.querySelectorAll('[data-cms-blog-list]').forEach((wrap) => {
        wrap.innerHTML = posts
          .map((post) => {
            const href = '/blog/read?slug=' + encodeURIComponent(post.slug);
            const img = post.image
              ? `<a href="${href}" class="block aspect-[16/9] overflow-hidden bg-surface-alt"><img src="${escapeHtml(post.image)}" alt="${escapeHtml(post.title || '')}" class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]" loading="lazy" /></a>`
              : '';
            return `
          <li class="reveal is-visible group overflow-hidden rounded-2xl border border-navy/10 bg-white transition duration-300 hover:-translate-y-1 hover:border-emerald/30 hover:shadow-[0_16px_40px_rgba(10,37,64,0.08)]">
            ${img}
            <div class="p-6 sm:p-8">
              <p class="text-xs font-semibold uppercase tracking-wider text-emerald">${escapeHtml(formatDate(post.date))}${post.author ? ' · ' + escapeHtml(post.author) : ''}</p>
              <h2 class="mt-3 text-xl font-bold text-navy transition group-hover:text-emerald sm:text-2xl">
                <a href="${href}">${escapeHtml(post.title)}</a>
              </h2>
              <p class="mt-3 text-sm leading-relaxed text-muted sm:text-base">${escapeHtml(post.excerpt || '')}</p>
              <a href="${href}" class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-emerald transition group-hover:gap-2">
                Read article <span aria-hidden="true">→</span>
              </a>
            </div>
          </li>`;
          })
          .join('');
      });
    } catch (e) {
      console.warn('Blog list live refresh skipped', e);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', refreshBlogList);
  } else {
    refreshBlogList();
  }
</script>
