---
import BaseLayout from '../../layouts/BaseLayout.astro';
import site from '../../../public/data/site.json';
---

<BaseLayout
  title={`Blog article | ${site.siteName}`}
  description="Corporate compliance articles and guides from Reasonable Compliance."
>
  <article>
    <section class="hero-atmosphere relative overflow-hidden text-white">
      <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="container-rc relative py-16 sm:py-20">
        <p class="text-sm font-semibold uppercase tracking-wider text-emerald">
          <a class="hover:text-white" href="/blog">Blog</a>
        </p>
        <h1 class="mt-3 max-w-3xl font-display text-3xl font-bold text-white sm:text-4xl" data-blog-title>
          Loading…
        </h1>
        <p class="mt-4 text-sm text-white/70" data-blog-meta></p>
      </div>
    </section>

    <section class="section-pad bg-surface">
      <div class="container-rc max-w-3xl">
        <div class="overflow-hidden rounded-2xl border border-navy/10 bg-white" data-blog-image-wrap hidden>
          <img src="" alt="" class="aspect-[16/9] w-full object-cover" data-blog-image />
        </div>
        <p class="text-lg leading-relaxed text-muted" data-blog-excerpt></p>
        <div class="blog-prose mt-8" data-blog-body></div>
        <p class="mt-8 hidden text-muted" data-blog-missing>
          This article was not found. <a class="text-emerald" href="/blog">Back to blog</a>
        </p>
        <div class="mt-12 flex flex-wrap gap-3 border-t border-navy/10 pt-8">
          <a href="/blog" class="btn-outline">← Back to blog</a>
          <a href="/contact" class="btn-primary">Book a consultation</a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<script>
  function formatDate(dateStr) {
    try {
      return new Date(dateStr + 'T00:00:00').toLocaleDateString('en-IN', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
      });
    } catch {
      return dateStr;
    }
  }

  function bodyToHtml(body) {
    var raw = String(body || '').trim();
    if (!raw) return '';
    if (/<[a-z][\s\S]*>/i.test(raw)) return raw;
    return raw
      .split(/\n\s*\n/)
      .map(function (block) {
        return block.trim();
      })
      .filter(Boolean)
      .map(function (block) {
        var lines = block.split('\n');
        var isList = lines.every(function (line) {
          return !line.trim() || line.trim().startsWith('- ');
        });
        if (isList) {
          return (
            '<ul>' +
            lines
              .filter(function (line) {
                return line.trim().startsWith('- ');
              })
              .map(function (line) {
                return '<li>' + line.replace(/^\s*-\s*/, '') + '</li>';
              })
              .join('') +
            '</ul>'
          );
        }
        if (lines.length === 1 && lines[0].length < 80 && !lines[0].endsWith('.')) {
          return '<h2>' + lines[0] + '</h2>';
        }
        return '<p>' + lines.join('<br>') + '</p>';
      })
      .join('');
  }

  async function load() {
    const params = new URLSearchParams(window.location.search);
    const slug = params.get('slug') || '';
    const titleEl = document.querySelector('[data-blog-title]');
    const metaEl = document.querySelector('[data-blog-meta]');
    const excerptEl = document.querySelector('[data-blog-excerpt]');
    const bodyEl = document.querySelector('[data-blog-body]');
    const missingEl = document.querySelector('[data-blog-missing]');
    const imageWrap = document.querySelector('[data-blog-image-wrap]');
    const imageEl = document.querySelector('[data-blog-image]');

    try {
      const blog = await fetch('/data/blog.json', { cache: 'no-store' }).then((r) => r.json());
      const post = (blog.items || []).find((item) => item.slug === slug && (item.status || 'published') !== 'draft');
      if (!post) {
        if (titleEl) titleEl.textContent = 'Article not found';
        if (missingEl) missingEl.classList.remove('hidden');
        return;
      }
      if (titleEl) titleEl.textContent = post.title || '';
      if (metaEl) metaEl.textContent = formatDate(post.date) + (post.author ? ' · ' + post.author : '');
      if (excerptEl) excerptEl.textContent = post.excerpt || '';
      if (bodyEl) bodyEl.innerHTML = bodyToHtml(post.body);
      if (post.image && imageWrap && imageEl) {
        imageEl.setAttribute('src', post.image);
        imageEl.setAttribute('alt', post.title || '');
        imageWrap.hidden = false;
        if (excerptEl) excerptEl.classList.add('mt-8');
      }
      document.title = post.seoTitle || post.title + ' | Reasonable Compliance';
    } catch (e) {
      if (titleEl) titleEl.textContent = 'Unable to load article';
      console.warn(e);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', load);
  } else {
    load();
  }
</script>
