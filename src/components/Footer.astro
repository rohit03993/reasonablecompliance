---
import site from '../../public/data/site.json';
import social from '../../public/data/social.json';

const networks = [
  { key: 'facebook', label: 'Facebook', href: social.facebook, path: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z' },
  { key: 'instagram', label: 'Instagram', href: social.instagram, path: 'M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z M17.5 6.5h.01 M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2z' },
  { key: 'linkedin', label: 'LinkedIn', href: social.linkedin, path: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z M2 9h4v12H2z M4 2a2 2 0 1 1 0 4 2 2 0 0 1 0-4z' },
  { key: 'twitter', label: 'Twitter / X', href: social.twitter, path: 'M4 4l11.733 16h4.267L8.267 4H4zm0 0h4.267L20 20h-4.267L4 4z' },
].filter((n) => n.href && String(n.href).trim() !== '');
---

<footer class="border-t border-navy/10 bg-navy text-white">
  <div class="container-rc section-pad !py-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-1">
        {
          site.logo ? (
            <div class="inline-flex rounded-lg bg-white px-3 py-2">
              <img
                src={site.logo}
                alt={site.siteName}
                class="h-14 w-auto max-w-[220px] object-contain"
                width="220"
                height="56"
              />
            </div>
          ) : (
            <p class="font-display text-2xl font-bold" data-cms="site.siteName">{site.siteName}</p>
          )
        }
        <p class="mt-2 text-sm text-white/70" data-cms="site.tagline">{site.tagline}</p>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-white/65">
          Professional corporate compliance, company secretary services, ROC filing,
          company registration, GST and legal advisory for businesses across India.
        </p>
        {
          networks.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-3">
              {networks.map((network) => (
                <a
                  href={network.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={network.label}
                  class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/20 text-white transition hover:border-emerald hover:bg-emerald"
                >
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d={network.path} stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </a>
              ))}
            </div>
          )
        }
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-emerald">Explore</p>
        <ul class="mt-4 space-y-2 text-sm text-white/75">
          <li><a class="hover:text-white" href="/about">About</a></li>
          <li><a class="hover:text-white" href="/services">Services</a></li>
          <li><a class="hover:text-white" href="/gallery">Gallery</a></li>
          <li><a class="hover:text-white" href="/contact">Contact</a></li>
          <li><a class="hover:text-white" href="/privacy">Privacy</a></li>
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-emerald">Services</p>
        <ul class="mt-4 space-y-2 text-sm text-white/75">
          <li><a class="hover:text-white" href="/services/company-incorporation">Company Incorporation</a></li>
          <li><a class="hover:text-white" href="/services/roc-secretarial-compliance">ROC Compliance</a></li>
          <li><a class="hover:text-white" href="/services/gst-business-registrations">GST & Registrations</a></li>
          <li><a class="hover:text-white" href="/services/intellectual-property">Trademark</a></li>
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-emerald">Get in touch</p>
        <ul class="mt-4 space-y-3 text-sm text-white/75">
          <li>
            <a class="hover:text-white" href={`mailto:${site.email}`} data-cms="site.email" data-cms-href="site.email">{site.email}</a>
          </li>
          {
            !site.phone.includes('X') && (
              <li>
                <a class="hover:text-white" href={`tel:${site.phone.replace(/\s/g, '')}`} data-cms-phone>
                  {site.phone}
                </a>
              </li>
            )
          }
          <li>
            <a class="btn-primary mt-2 inline-flex" href="/contact" data-cms="site.ctaPrimary">{site.ctaPrimary}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-white/50 sm:flex-row sm:items-center sm:justify-between">
      <p>
        &copy; {new Date().getFullYear()} {site.siteName}. All rights reserved.
      </p>
      <p>Corporate legal & regulatory compliance across India</p>
    </div>
  </div>
</footer>
