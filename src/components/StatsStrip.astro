---
import homepage from '../../public/data/homepage.json';

const stats = homepage.stats || [];
---

<section class="relative overflow-hidden bg-navy text-white">
  <div class="pointer-events-none absolute inset-0 opacity-30" aria-hidden="true">
    <div class="absolute -left-10 top-0 h-40 w-40 rounded-full bg-emerald/40 blur-3xl animate-float"></div>
    <div class="absolute bottom-0 right-0 h-48 w-48 rounded-full bg-emerald/20 blur-3xl animate-float-delayed"></div>
  </div>
  <div class="container-rc relative grid gap-8 py-12 sm:grid-cols-2 lg:grid-cols-4 lg:py-14">
    {
      stats.map((stat, index) => (
        <div class="reveal text-center lg:text-left" style={`transition-delay: ${index * 80}ms`}>
          <p class="font-display text-2xl font-bold text-emerald sm:text-3xl">{stat.value}</p>
          <p class="mt-1 text-sm text-white/70">{stat.label}</p>
        </div>
      ))
    }
  </div>
</section>
