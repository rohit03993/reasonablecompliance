---
import servicesData from '../data/services.json';

const sorted = [...servicesData.items].sort((a, b) => a.order - b.order);
---

<section class="section-pad bg-surface" id="services">
  <div class="container-rc">
    <div class="reveal max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-emerald">Our Services</p>
      <h2 class="mt-2 text-3xl font-bold sm:text-4xl">Corporate compliance, end to end</h2>
      <p class="mt-3 text-muted">
        From company registration India to annual ROC filing, GST registration, FEMA compliance,
        and trademark registration — practical support for startups and growing businesses.
      </p>
    </div>

    <ul class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        sorted.map((service) => (
          <li class="reveal border-t border-navy/10 pt-6">
            <h3 class="text-xl font-semibold">
              <a class="transition hover:text-emerald" href={`/services/${service.slug}`}>
                {service.title}
              </a>
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{service.summary}</p>
            <a
              href={`/services/${service.slug}`}
              class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-emerald hover:text-emerald-dark"
            >
              View details
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
