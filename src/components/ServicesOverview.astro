---
import servicesData from '../../public/data/services.json';
import Icon from './Icon.astro';

const sorted = [...servicesData.items].sort((a, b) => a.order - b.order);
---

<section class="section-pad bg-surface" id="services">
  <div class="container-rc">
    <div class="reveal max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-emerald">Our Services</p>
      <h2 class="mt-2 text-3xl font-bold sm:text-4xl">Corporate compliance, end to end</h2>
      <p class="mt-3 text-muted">
        From company registration and ROC filing to GST, FEMA, trademarks and legal advisory —
        practical solutions for startups and growing businesses across India.
      </p>
    </div>

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        sorted.map((service, index) => (
          <li
            class="reveal service-card group rounded-2xl border border-navy/10 bg-white p-6 transition duration-300 hover:-translate-y-1 hover:border-emerald/40 hover:shadow-[0_16px_40px_rgba(10,37,64,0.08)]"
            style={`transition-delay: ${index * 60}ms`}
          >
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-emerald/10 text-emerald transition duration-300 group-hover:scale-110 group-hover:bg-emerald group-hover:text-white">
              <Icon name={service.icon || 'spark'} />
            </div>
            <h3 class="text-xl font-semibold text-navy">
              <a class="transition hover:text-emerald" href={`/services/${service.slug}`}>
                {service.title}
              </a>
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{service.summary}</p>
            <a
              href={`/services/${service.slug}`}
              class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-emerald transition group-hover:gap-2 hover:text-emerald-dark"
            >
              View details
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
