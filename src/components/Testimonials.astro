---
import testimonials from '../../public/data/testimonials.json';
import Icon from './Icon.astro';
---

<section class="section-pad bg-surface-alt" id="testimonials">
  <div class="container-rc">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-emerald">Testimonials</p>
      <h2 class="mt-2 text-3xl font-bold sm:text-4xl" data-cms="testimonials.title">{testimonials.title}</h2>
    </div>
    <ul class="mt-12 grid gap-6 md:grid-cols-3" data-cms-testimonials>
      {
        testimonials.items.map((item, index) => (
          <li
            class="reveal group rounded-2xl border border-navy/10 bg-white p-6 transition duration-300 hover:-translate-y-1 hover:border-emerald/30 hover:shadow-[0_16px_40px_rgba(10,37,64,0.08)]"
            style={`transition-delay: ${index * 80}ms`}
          >
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-emerald/10 text-emerald transition group-hover:bg-emerald group-hover:text-white">
              <Icon name="quote" class="h-5 w-5" />
            </div>
            <p class="text-sm leading-relaxed text-muted sm:text-base">“{item.quote}”</p>
            <p class="mt-5 text-sm font-semibold text-navy">{item.name}</p>
            <p class="text-xs text-muted">{item.role}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
