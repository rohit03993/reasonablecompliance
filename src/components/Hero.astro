---
import site from '../../public/data/site.json';
import homepage from '../../public/data/homepage.json';

const { hero } = homepage;
---

<section class="hero-atmosphere relative overflow-hidden text-white">
  <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-16 top-20 h-56 w-56 rounded-full border border-emerald/30 animate-pulse-soft" aria-hidden="true"></div>
  <div class="pointer-events-none absolute bottom-10 right-1/4 h-24 w-24 rounded-full bg-emerald/20 blur-2xl animate-float" aria-hidden="true"></div>

  <div class="container-rc relative flex min-h-[calc(100svh-5rem)] flex-col justify-center py-16 sm:py-20 lg:py-24">
    <p class="fade-up inline-flex w-fit items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-emerald backdrop-blur-sm">
      Trusted Compliance. Clear Advice.
    </p>
    <p class="fade-up-delay-1 mt-5 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl" data-cms="site.siteName">
      {site.siteName}
    </p>
    <h1 class="fade-up-delay-1 mt-4 max-w-3xl font-display text-2xl font-semibold leading-snug !text-white sm:text-3xl lg:text-4xl" data-cms="homepage.hero.headline">
      {hero.headline}
    </h1>
    <p class="fade-up-delay-2 mt-4 max-w-2xl text-base leading-relaxed text-white/80 sm:text-lg" data-cms="homepage.hero.subheadline">
      {hero.subheadline}
    </p>
    <p class="mt-6 max-w-2xl text-sm leading-relaxed text-white/65 sm:text-base" data-cms="homepage.hero.intro">
      {hero.intro}
    </p>
    <div class="mt-8 flex flex-wrap gap-3 fade-up-delay-2">
      <a href="/contact" class="btn-primary shadow-lg shadow-emerald/20" data-cms="site.ctaPrimary">{site.ctaPrimary}</a>
      <a href="/services" class="btn-secondary" data-cms="site.ctaSecondary">{site.ctaSecondary}</a>
    </div>
  </div>
</section>
