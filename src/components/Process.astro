---
import homepage from '../../public/data/homepage.json';
import Icon from './Icon.astro';

const { processTitle, processSteps } = homepage;
const stepIcons = ['search', 'map', 'check', 'support'];
---

<section class="section-pad relative overflow-hidden bg-navy text-white" id="process">
  <div class="pointer-events-none absolute inset-0 opacity-40" aria-hidden="true">
    <div class="absolute left-1/4 top-10 h-32 w-32 rounded-full bg-emerald/30 blur-3xl animate-float"></div>
  </div>
  <div class="container-rc relative">
    <div class="reveal max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-emerald">How we work</p>
      <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl" data-cms="homepage.processTitle">{processTitle}</h2>
    </div>
    <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-cms-process>
      {
        processSteps.map((step, index) => (
          <li
            class="reveal rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm transition duration-300 hover:-translate-y-1 hover:border-emerald/50 hover:bg-white/10"
            style={`transition-delay: ${index * 80}ms`}
          >
            <div class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-emerald/20 text-emerald">
              <Icon name={stepIcons[index % stepIcons.length]} class="h-5 w-5" />
            </div>
            <p class="font-display text-3xl font-bold text-emerald">
              {String(index + 1).padStart(2, '0')}
            </p>
            <h3 class="mt-3 text-lg font-semibold text-white">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/70">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
