---
import homepage from '../data/homepage.json';

const { processTitle, processSteps } = homepage;
---

<section class="section-pad bg-navy text-white" id="process">
  <div class="container-rc">
    <div class="reveal max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-emerald">How we work</p>
      <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">{processTitle}</h2>
    </div>
    <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        processSteps.map((step, index) => (
          <li class="reveal border-t border-white/15 pt-6">
            <p class="font-display text-3xl font-bold text-emerald">
              {String(index + 1).padStart(2, '0')}
            </p>
            <h3 class="mt-3 text-lg font-semibold text-white">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/70">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
