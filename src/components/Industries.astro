---
import homepage from '../../public/data/homepage.json';

const { industriesTitle, industriesIntro, industries } = homepage;
---

<section class="section-pad bg-surface" id="industries">
  <div class="container-rc">
    <div class="reveal max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-emerald">Industries</p>
      <h2 class="mt-2 text-3xl font-bold sm:text-4xl" data-cms="homepage.industriesTitle">{industriesTitle}</h2>
      <p class="mt-3 text-muted" data-cms="homepage.industriesIntro">{industriesIntro}</p>
    </div>
    <ul class="mt-10 grid gap-3 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5" data-cms-list="homepage.industries">
      {
        industries.map((industry, index) => (
          <li
            class="reveal flex items-center gap-3 rounded-xl border border-navy/10 bg-white px-4 py-3 text-sm font-medium text-navy transition duration-300 hover:-translate-y-0.5 hover:border-emerald/40 hover:shadow-md"
            style={`transition-delay: ${index * 40}ms`}
          >
            <span class="h-2 w-2 shrink-0 rounded-full bg-emerald" aria-hidden="true" />
            {industry}
          </li>
        ))
      }
    </ul>
  </div>
</section>
